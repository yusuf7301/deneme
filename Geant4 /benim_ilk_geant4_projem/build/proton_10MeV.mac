# Run başlangıç ayarı
/run/initialize

# Parçacık türü
/gun/particle proton

# Parçacık enerjisi
/gun/energy 10 MeV

# Başlangıç konumu
/gun/position 0 0 -20 cm

# Hareket yönü
/gun/direction 0 0 1

# Çıktı seviyeleri
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Çalıştırılacak event sayısı
/run/beamOn 100